# Public site URL, used for canonical links and sitemap. A public IP is enough for the first deployment.
NEXT_PUBLIC_SITE_URL=http://YOUR_PUBLIC_IP

# Public API origin. Leave empty when /api/v1 is reverse-proxied on the same domain.
# If you use a separate API domain, provide the full HTTPS origin without a trailing slash.
NEXT_PUBLIC_SKILLDOCK_API_BASE_URL=

# Optional independent COS/CDN origin for ZIP packages and public resources.
# Leave empty during local development. Do not include a trailing slash.
NEXT_PUBLIC_DOWNLOAD_BASE_URL=

# Server-only settings for the public SkillDock API.
# Bind to 0.0.0.0 on a cloud server; /api/local remains disabled in that mode.
SITE_HOST=127.0.0.1
SITE_PORT=3000
SKILLDOCK_STATS_PATH=data/local/skill-stats.json
SKILLDOCK_STATS_TIMEZONE=Asia/Shanghai

# Optional COS/CDN origin used by the API after it records a download.
# Example: https://downloads.your-domain.example.com
SKILLDOCK_DOWNLOAD_BASE_URL=

# Optional LLM enrichment used only by the local Research2Story Skill.
# The public website never reads these values.
# LLM_BASE_URL=https://your-llm-provider.example.com/v1
# LLM_API_KEY=replace-in-your-own-environment
# LLM_MODEL=replace-with-your-model
